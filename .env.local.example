# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it.
#
# Get these from Supabase Dashboard → your project → Settings → API:
#   - SUPABASE_URL   = "Project URL" (e.g. https://abcdefgh.supabase.co)
#   - SUPABASE_SERVICE_ROLE_KEY = "service_role" key (the SECRET one, NOT anon)
#
# The service_role key bypasses RLS — treat it like a database password.
# Used only by import-to-supabase.js for one-off data loads.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
